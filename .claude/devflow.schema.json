{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devflow project configuration",
  "type": "object",
  "required": ["github", "baseBranch", "checks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "github": {
      "type": "object",
      "required": ["owner", "repo"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "default": "origin", "description": "Git remote that points at GitHub." }
      }
    },
    "baseBranch": { "type": "string", "minLength": 1, "description": "Branches start from <remote>/<baseBranch>; PRs target it." },
    "protectedBranches": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["main", "master", "develop"],
      "description": "The guard hook blocks pushes to these and to baseBranch."
    },
    "branchPattern": {
      "type": "string",
      "default": "{type}/{issue}-{slug}",
      "description": "Placeholders: {type} (feat|fix|chore|docs|refactor|test), {issue}, {slug} (at most 5 words, kebab-case)."
    },
    "commitScope": { "type": "string", "default": "#{issue}", "description": "Conventional Commits scope." },
    "specDir": { "type": "string", "default": "docs/specs" },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ready": { "type": "string", "default": "agent:ready" },
        "inProgress": { "type": "string", "default": "agent:in-progress" },
        "review": { "type": "string", "default": "agent:review" },
        "blocked": { "type": "string", "default": "agent:blocked" },
        "e2e": { "type": "string", "default": "needs-e2e" },
        "devflow": { "type": "string", "default": "devflow", "description": "Put on every PR devflow opens; /devflow:sync targets PRs with it." },
        "riskLow": { "type": "string", "default": "risk:low", "description": "Issue/PR label: eligible for the merge gate." },
        "riskHigh": { "type": "string", "default": "risk:high", "description": "Issue/PR label: waits for a human merge." },
        "stacked": { "type": "string", "default": "stacked", "description": "PR label: the PR is based on another open devflow PR." }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "description": "How /devflow:spec and next-task judge whether a change needs a human merge. Unsure means high.",
      "properties": {
        "highWhen": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "authentication or permissions",
            "data migration or deleting stored data",
            "a change to a public API contract that breaks existing clients",
            "security-sensitive input handling",
            "payments or money"
          ],
          "description": "Plain-language conditions; a task matching any is risk:high."
        },
        "highPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Globs (** * ?). A PR touching a matching file is escalated to risk:high before it is opened."
        }
      }
    },
    "mergeGate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read by the devflow merge gate GitHub Action. Claude itself never merges.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "dryRun": { "type": "boolean", "default": true, "description": "Log what would be merged without merging." },
        "requiredChecks": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["devflow/review"],
          "description": "Names of check runs or commit-status contexts that must be green before the gate merges."
        },
        "method": { "enum": ["merge"], "default": "merge", "description": "Merge commits are required for stacked PRs." }
      }
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "e2eFramework": {
          "type": "boolean",
          "default": false,
          "description": "True when the project has an automated e2e/browser test setup that can hold committed e2e tests. When false, e2e test rows are covered by the verify stage only."
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "description": "Run in order; all must pass before review.",
      "items": {
        "type": "object",
        "required": ["name", "run"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "run": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "items": { "enum": ["http", "browser"] },
          "uniqueItems": true,
          "default": [],
          "description": "[] disables verification."
        },
        "devServer": {
          "type": "object",
          "required": ["run", "url"],
          "additionalProperties": false,
          "properties": {
            "run": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "readyTimeoutSec": { "type": "integer", "minimum": 1, "default": 60 }
          }
        },
        "browserTool": { "enum": ["playwright", "chrome"], "default": "playwright" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "testMatrix": {
          "type": "boolean",
          "default": true,
          "description": "Run the QA step in /devflow:spec: an agent drafts a test matrix from the acceptance criteria and reports criteria it cannot test."
        },
        "qaModel": {
          "enum": ["opus", "sonnet"],
          "default": "opus",
          "description": "Model for the QA agent. Opus is better at spotting untestable criteria and cases the spec leaves out; Sonnet is cheaper."
        }
      }
    },
    "nextTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultLimit": { "type": "integer", "minimum": 1, "default": 3 },
        "maxFixRounds": { "type": "integer", "minimum": 0, "default": 2 },
        "maxReviewRounds": { "type": "integer", "minimum": 0, "default": 2 }
      }
    }
  }
}
