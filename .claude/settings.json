{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u github:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(curl * http://127.0.0.1:5050/*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff check:*)",
      "Bash(.venv/bin/ruff format --check:*)",
      "Bash(make run:*)",
      "mcp__claude_ai_github__*",
      "Bash(make setup:*)",
      "Bash(git worktree:*)",
      "Bash(git merge:*)",
      "Bash(git push github:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push * develop)",
      "Bash(git push * *:develop)",
      "Bash(git push * feature/example_taskboard)",
      "Bash(git push * *:feature/example_taskboard)",
      "Bash(gh pr merge:*)",
      "mcp__claude_ai_github__merge_pull_request",
      "mcp__claude_ai_github__delete_repository",
      "Bash(git push --all *)",
      "Bash(git push * --all)",
      "Bash(git push * --all *)",
      "Bash(git push --mirror *)",
      "Bash(git push * --mirror)",
      "Bash(git push * --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete)",
      "Bash(git push * --delete *)",
      "Bash(git push -d *)",
      "Bash(git push * -d)",
      "Bash(git push * -d *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *refs/heads/develop*)",
      "Bash(git push *refs/heads/feature/example_taskboard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block_git_add_all.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty'); case \"$f\" in *.py) \"${CLAUDE_PROJECT_DIR:-.}/.venv/bin/ruff\" format \"$f\";; esac 2>/dev/null || true",
            "statusMessage": "Formatting Python with ruff"
          }
        ]
      }
    ]
  }
}
